# Copy to .env and replace every CHANGEME; the demo refuses to start while one is left.
# Make each value with:  openssl rand -hex 16
# These are for a local trial only.
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGEME
# the demo person, `demo`, signs in at the door with this
DEMO_PERSON_PASSWORD=CHANGEME
HOUSE_PYTHON_CLIENT_SECRET=CHANGEME
HOUSE_NODE_CLIENT_SECRET=CHANGEME
# "on" shows the weather slot in both houses; it then sends the visitor's location to outside services (NOTICE)
HOUSE_WEATHER=off
# build Chowkidar, bhandara or dakiya from a local checkout instead of its public repository
# CHOWKIDAR_CONTEXT=../chowkidar
# BHANDARA_CONTEXT=../bhandara
# DAKIYA_CONTEXT=../dakiya
